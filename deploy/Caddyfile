# Front proxy for fair-testbed. Obtains Let's Encrypt certificates
# automatically (needs ports 80 and 443 reachable from the internet).
{
	email {$ACME_EMAIL}
}

{$PIDRELAY_HOST} {
	encode gzip

	# Redirect service: https://w3id.org/<prefix>/... arrives here as /pid/<prefix>/...
	handle /pid/* {
		reverse_proxy redirector:80
	}

	# Management UI
	redir /pid-manager /pid-manager/
	handle /pid-manager/* {
		reverse_proxy ui:8000
	}

	# ERDERA demo VP Index, a separate compose project that joins this
	# stack's network (luizbonino/erdera-demonstrators, infra/demo-index).
	# The client knows its path (PUBLIC_PATH=/demo-index) and gets requests
	# without it. No redirect for the bare path: FDPs POST their ping there.
	@demoindex path /demo-index /demo-index/*
	handle @demoindex {
		uri strip_prefix /demo-index
		reverse_proxy erdera-demo-index-client:80
	}

	# Other testbed services go here, e.g.
	# handle /fdp/* { reverse_proxy fdp:80 }

	handle {
		respond "fair-testbed" 404
	}
}
