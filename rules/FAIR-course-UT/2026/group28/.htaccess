RewriteEngine on

Header always append Vary Accept

# Ontology
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^ont(/1\.0\.0)?$ https://github.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/blob/main/ontology/dutch_electricity_ontology.owx [R=303,L]
RewriteRule ^ont(/1\.0\.0)?$ https://raw.githubusercontent.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/main/ontology/dutch_electricity_ontology.owx [R=303,L]

# FAIRified RDF data
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data$ https://github.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/blob/main/rdf/coteq_electricity_2013_csv%20(1).ttl [R=303,L]
RewriteRule ^data$ https://raw.githubusercontent.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/main/rdf/coteq_electricity_2013_csv%20(1).ttl [R=303,L]

# Original CSV data
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data/original$ https://github.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/blob/main/data/raw/coteq_electricity_2013.csv [R=303,L]
RewriteRule ^data/original$ https://raw.githubusercontent.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28/main/data/raw/coteq_electricity_2013.csv [R=303,L]

# Project repository
RewriteRule ^$ https://github.com/vasaraju686-os/Dutch-Electricity-Consumption-Group-28 [R=302,L]
