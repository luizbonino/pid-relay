RewriteEngine On
Header always append Vary Accept

# Ontology
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^ont(/1\.0\.0)?$ https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/blob/main/Dutch_Electricity_fair_project/ontology/dutch_electricity_ontology.owx [R=303,L]
RewriteRule ^ont(/1\.0\.0)?$ https://raw.githubusercontent.com/varshavasaraju/Dutch-Electricity-Fair-Data/main/Dutch_Electricity_fair_project/ontology/dutch_electricity_ontology.owx [R=303,L]

# FAIRified RDF data
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data$ https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/blob/main/Dutch_Electricity_fair_project/rdf/coteq_electricity_2013_csv%20(1).ttl [R=303,L]
RewriteRule ^data$ https://raw.githubusercontent.com/varshavasaraju/Dutch-Electricity-Fair-Data/main/Dutch_Electricity_fair_project/rdf/coteq_electricity_2013_csv%20(1).ttl [R=303,L]

# Original CSV
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data/original$ https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/blob/main/Dutch_Electricity_fair_project/data/raw/coteq_electricity_2013.csv [R=303,L]
RewriteRule ^data/original$ https://raw.githubusercontent.com/varshavasaraju/Dutch-Electricity-Fair-Data/main/Dutch_Electricity_fair_project/data/raw/coteq_electricity_2013.csv [R=303,L]

# Dataset metadata
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^metadata$ https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/blob/main/Dutch_Electricity_fair_project/reports/dataset_metadata.ttl [R=303,L]
RewriteRule ^metadata$ https://raw.githubusercontent.com/varshavasaraju/Dutch-Electricity-Fair-Data/main/Dutch_Electricity_fair_project/reports/dataset_metadata.ttl [R=303,L]

# Project repository
RewriteRule ^$ https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/tree/main/Dutch_Electricity_fair_project [R=302,L]
