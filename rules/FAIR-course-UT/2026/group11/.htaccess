# Birdsoftheworld-fairified dataset, Canvas Group 11.
RewriteEngine on

RewriteRule ^ont/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/ontology/ontology.ttl [R=303,L]

RewriteRule ^data/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/data/birdsoftheworld-fairified.ttl [R=303,L]
RewriteRule ^original\.csv$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/preprocessing/Birdsoftheworld.csv [R=303,L]
RewriteRule ^metadata/catalog/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/catalog.ttl [R=303,L]
RewriteRule ^metadata/dataset/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/dataset.ttl [R=303,L]
RewriteRule ^metadata/distribution-original/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/distribution-original.ttl [R=303,L]
RewriteRule ^metadata/distribution-fairified/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/distribution-fairified.ttl [R=303,L]

RewriteRule ^schema/catalog/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/catalog-shape.ttl [R=303,L]
RewriteRule ^schema/dataset/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/dataset-shape.ttl [R=303,L]
RewriteRule ^schema/distribution/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/distribution-shape.ttl [R=303,L]
RewriteRule ^schema/resource/?$ https://raw.githubusercontent.com/wouter-deen/birdsoftheworld-dataset-fairification/main/metadata/resource-shape.ttl [R=303,L]
